# =====================================================
# APPLICATION ENVIRONMENT TEMPLATE
# Copy to .env and fill values
# =====================================================

# --- General ---
NODE_ENV=development

# --- Backend ---
PORT=3001
HOST=0.0.0.0
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:3001
APP_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://leaduser:leadpass@postgres:5432/leadgenerator

# --- Redis (prepared for Phase 2) ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Provider Layer (Companies data source) ---
COMPANY_PROVIDER_API_KEY=
COMPANY_PROVIDER_BASE_URL=

# --- Serpro CNPJ Busca (opcional, para enriquecimento sem CNPJ) ---
SERPRO_TOKEN=
SERPRO_BASE_URL=https://gateway.apiserpro.serpro.com.br

# --- ReceitaWS (gratuito para busca de CNPJ por nome) ---
# Token de acesso gratuito em: https://receitaws.com.br
RECEITAWS_TOKEN=

# --- Maps Provider (configurable) ---
MAP_PROVIDER_API_KEY=
MAP_PROVIDER=openstreetmap

# --- OpenWA (WhatsApp verification) ---
OPENWA_URL=http://mock-openwa:8000

# --- Email (SMTP padrão do sistema) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seudominio.com

# --- E-mail Marketing ---
# Chave para criptografar senhas SMTP dos usuários (gere com: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
# Limite diário padrão de e-mails por workspace
DEFAULT_EMAIL_DAILY_LIMIT=500

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- Plans (prepared for future) ---
APP_PLAN_FREE_CREDITS=100
APP_PLAN_STARTER_CREDITS=1000
APP_PLAN_PRO_CREDITS=5000
APP_PLAN_ENTERPRISE_CREDITS=50000
